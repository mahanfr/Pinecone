
contract Basic {
    ~ Account struct
    public struct Account {
        active @bool,
        balance @u128,
        address @address,
    }

    public voters @Map<address, Account>;
    nonce @u64;

    func get_nonce() @u64 {
        sum := 1;
        nonce += sum;
        add();
        return nonce;
    }
}
